# Google AI (Gemini) — required for AI analysis features
GOOGLE_API_KEY=your_google_api_key_here

# Google PageSpeed Insights — optional, improves CWV rate limits
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Ngrok tunnel — only needed for local Docker+ngrok setup (not needed on Vercel)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-domain.ngrok-free.dev

# SEO Data API (moveupx) — GSC + Ahrefs data
SEO_API_KEY=your_seo_api_key_here

# SerpAPI — real Google SERPs. Required: rank tracking is pinned to this source and will
# skip (record nothing) rather than fall back to another engine and corrupt the series.
SERPAPI_KEY=your_serpapi_key_here

# Shared secret for the /api/cron/* jobs. Vercel sends `Authorization: Bearer $CRON_SECRET`
# automatically once this var exists. Unset = every cron endpoint 401s (fails closed, so the
# paid SERP/PageSpeed sweeps can never be triggered by an outsider).
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# Rank tracking cron tuning (optional — defaults shown). The job drains a queue: each hourly
# run checks keywords not yet done today, oldest first, until the budget expires.
TRACK_WORKERS=6
TRACK_RUN_BUDGET_S=240
TRACK_MAX_PER_RUN=400

# Scraper settings
PROXY_URL=
SCRAPER_SLEEP_MIN=3
SCRAPER_SLEEP_MAX=7

# ── Vercel deployment ─────────────────────────────────────────────────────────
# Google OAuth credentials (base64-encoded, for serverless environments)
# Generate TOKEN_PICKLE_B64:  python -c "import base64; print(base64.b64encode(open('token.pickle','rb').read()).decode())"
# Generate CLIENT_SECRET_JSON: paste the full one-line content of client_secret.json
TOKEN_PICKLE_B64=
CLIENT_SECRET_JSON=
